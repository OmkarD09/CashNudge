# CashNudge — Environment Configuration

# Prior Labs TabPFN API Token
# Required for real cloud-hosted TabPFN inference.
# Generate your token at: https://platform.priorlabs.ai/account/api-keys
TABPFN_TOKEN=your_tabpfn_api_token_here

# Risk Classification Thresholds (Probabilities between 0.0 and 1.0)
CASHNUDGE_RISK_THRESHOLD_LOW=0.35
CASHNUDGE_RISK_THRESHOLD_HIGH=0.70

# Minimum historical paid invoices required to train model
CASHNUDGE_MIN_HISTORICAL_SAMPLES=5

# Gemma Follow-Up Drafting Configuration
# Supported providers: 'mock', 'ollama', 'hosted'
GEMMA_PROVIDER=mock

# Local Ollama Configuration (when GEMMA_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=30.0

# OpenAI-Compatible Hosted Gemma Configuration (when GEMMA_PROVIDER=hosted)
# e.g., OpenRouter, Groq, Together, vLLM
GEMMA_HOSTED_BASE_URL=https://openrouter.ai/api/v1
GEMMA_HOSTED_API_KEY=your_openrouter_or_hosted_api_key_here
GEMMA_HOSTED_MODEL=google/gemma-4-26b-a4b-it

# Server & Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CASHNUDGE_MAX_UPLOAD_SIZE_BYTES=5242880

# Public API Rate Limiting & Abuse Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LEDGER_PER_MINUTE=60
RATE_LIMIT_FOLLOWUP_PER_MINUTE=20
